{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Polly": "Error"
    }
  },
  "AllowedHosts": "*",
  "Role": "Api",
  "Kafka": {
    "BootstrapServers": "localhost:29092",
    "AuditTopic": "audit.events",
    "MessageTimeoutMs": 10000
  },
  "OutboxRelay": {
    "BatchSize": 200,
    "LeaseSeconds": 30,
    "PollIntervalMs": 1000,
    "DeadLetterAttempts": 10
  }
}
