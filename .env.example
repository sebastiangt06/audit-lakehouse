# Copy to .env:  cp .env.example .env
# All values are LOCAL-ONLY dummies for the Docker Compose PoC. No cloud account is required.

# --- SQL Server (core OLTP + outbox) ---
# Must satisfy SQL Server password policy (8+ chars, upper, lower, digit, symbol).
SA_PASSWORD=Makers_Local_2026!
MSSQL_PID=Developer
CORE_DB=MakersCore

# --- Object storage (SeaweedFS, S3-compatible) ---
S3_ACCESS_KEY=makers-local-key
S3_SECRET_KEY=makers-local-secret
AWS_REGION=us-east-1
S3_ENDPOINT=http://seaweedfs:8333
WAREHOUSE_BUCKET=warehouse

# --- Kafka ---
KAFKA_BOOTSTRAP=kafka:9092
AUDIT_TOPIC=audit.events
LOGS_TOPIC=app.logs

# --- Iceberg REST catalog (~ AWS Glue Data Catalog in prod) ---
ICEBERG_REST_URI=http://iceberg-rest:8181
ICEBERG_CATALOG=lake

# --- Host ports ---
CORE_API_PORT=8081
TRINO_PORT=8080

# --- Streaming ingestion (Glue job Kafka -> Iceberg bronze) ---
# 60s trades latency for fewer small files (see ADR-006).
INGEST_TRIGGER_SECONDS=60
MAX_OFFSETS_PER_TRIGGER=50000

# --- Data lifecycle (ADR-008) ---
HOT_DAYS=90
OUTBOX_RETENTION_DAYS=7
RETENTION_SNAPSHOTS_DAYS=7
